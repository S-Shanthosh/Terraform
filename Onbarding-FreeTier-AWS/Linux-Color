#!/usr/bin/env bash
# setup-terminal.sh — one-shot terminal color for Amazon Linux 2023
set -e

# --- 1. Base packages ---
sudo dnf install -y git make gawk python3-pip unzip curl tar

# --- 2. Colors + aliases in ~/.bashrc (idempotent) ---
if ! grep -q "Color enhancements" ~/.bashrc; then
cat >> ~/.bashrc << 'EOF'
# ===== Color enhancements =====
alias ls='ls --color=auto'
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'
export LESS='-R'
export MANPAGER='less -R'
# ===== End color enhancements =====
EOF
fi

# --- 3. ble.sh — live syntax highlighting while typing ---
if [ ! -f ~/.local/share/blesh/ble.sh ]; then
  git clone --recursive --depth 1 --shallow-submodules \
    https://github.com/akinomyoga/ble.sh.git /tmp/ble.sh
  make -C /tmp/ble.sh install PREFIX=~/.local
  rm -rf /tmp/ble.sh
  echo 'source ~/.local/share/blesh/ble.sh' >> ~/.bashrc
fi

# --- 4. lolcat (rainbow output) ---
pip3 install --user lolcat || true

# --- 5. lnav (log viewer) — self-cleaning ---
if ! command -v lnav >/dev/null; then
  TMPDIR=$(mktemp -d)
  curl -sSL -o "$TMPDIR/lnav.zip" \
    https://github.com/tstack/lnav/releases/download/v0.14.1/lnav-0.14.1-linux-musl-x86_64.zip
  unzip -q -o "$TMPDIR/lnav.zip" -d "$TMPDIR"
  sudo mv "$TMPDIR/lnav-0.14.1/lnav" /usr/local/bin/
  rm -rf "$TMPDIR"
fi

# --- 6. bat (cat with syntax highlighting) ---
if ! command -v bat >/dev/null; then
  sudo dnf copr enable fcsm/bat -y || true
  sudo dnf install -y bat || true
fi

# --- 7. Custom prompt — write to BOTH .bashrc and .bash_profile ---
for rc in "$HOME/.bashrc" "$HOME/.bash_profile"; do
  if [ -f "$rc" ] && ! grep -q "Custom prompt color" "$rc"; then
cat >> "$rc" << 'EOF'

# Custom prompt color (purple user@host, yellow dir)
PS1='\[\e[1;35m\][\u@\h\[\e[0m\] \[\e[1;33m\]\W\[\e[0m\]]\$ '
EOF
  fi
done

# --- 8. Modern CLI: ripgrep + fd (prebuilt binaries, no EPEL) ---
ARCH=$(uname -m)
case "$ARCH" in
  x86_64)  RG_ARCH="x86_64-unknown-linux-musl"; FD_ARCH="x86_64-unknown-linux-musl" ;;
  aarch64) RG_ARCH="aarch64-unknown-linux-musl"; FD_ARCH="aarch64-unknown-linux-musl" ;;
  *)       RG_ARCH=""; FD_ARCH="" ;;
esac

# ripgrep
if [ -n "$RG_ARCH" ] && ! command -v rg >/dev/null; then
  TMPDIR=$(mktemp -d)
  curl -sSL -o "$TMPDIR/rg.tar.gz" \
    "https://github.com/BurntSushi/ripgrep/releases/latest/download/ripgrep-14.1.1-${RG_ARCH}.tar.gz"
  tar -xzf "$TMPDIR/rg.tar.gz" -C "$TMPDIR"
  sudo mv "$TMPDIR"/ripgrep-*/rg /usr/local/bin/
  rm -rf "$TMPDIR"
fi

# fd
if [ -n "$FD_ARCH" ] && ! command -v fd >/dev/null; then
  TMPDIR=$(mktemp -d)
  curl -sSL -o "$TMPDIR/fd.tar.gz" \
    "https://github.com/sharkdp/fd/releases/latest/download/fd-v9.0.0-${FD_ARCH}.tar.gz"
  tar -xzf "$TMPDIR/fd.tar.gz" -C "$TMPDIR"
  sudo mv "$TMPDIR"/fd-v*/fd /usr/local/bin/
  rm -rf "$TMPDIR"
fi

echo "✅ Setup complete. Run: source ~/.bashrc && source ~/.bash_profile"
