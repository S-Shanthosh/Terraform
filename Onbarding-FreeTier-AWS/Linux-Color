#!/usr/bin/env bash
# Linux-Color — terminal setup for Amazon Linux 2023
# Supports x86_64 and aarch64 where release assets are available.
set -Eeuo pipefail

# --- 0. Platform check ---
if ! command -v dnf >/dev/null 2>&1; then
  echo "This script currently targets Amazon Linux 2023 / DNF-based systems."
  exit 1
fi

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64|aarch64) ;;
  *) echo "Unsupported architecture: $ARCH"; exit 1 ;;
esac

# Temporary downloads are always cleaned up, including on failure.
WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

echo "==> Installing base packages..."
sudo dnf install -y git make gawk python3-pip unzip curl tar

# --- 1. Classic colour support ---
if ! grep -q "Linux-Color: classic colours" "$HOME/.bashrc" 2>/dev/null; then
cat >> "$HOME/.bashrc" <<'EOF'

# Linux-Color: classic colours
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'
export LESS='-R'
export MANPAGER='less -R'
EOF
fi

# --- 2. ble.sh: interactive syntax highlighting and suggestions ---
if [ ! -f "$HOME/.local/share/blesh/ble.sh" ]; then
  echo "==> Installing ble.sh..."
  git clone --recursive --depth 1 --shallow-submodules \
    https://github.com/akinomyoga/ble.sh.git "$WORKDIR/ble.sh"
  make -C "$WORKDIR/ble.sh" install PREFIX="$HOME/.local"
fi
if ! grep -Fq 'source ~/.local/share/blesh/ble.sh' "$HOME/.bashrc"; then
  echo '[[ $- == *i* ]] && source ~/.local/share/blesh/ble.sh' >> "$HOME/.bashrc"
fi

# --- 3. lolcat: rainbow output (best effort) ---
if ! command -v lolcat >/dev/null 2>&1; then
  echo "==> Installing lolcat (optional)..."
  python3 -m pip install --user lolcat || echo "NOTE: lolcat could not be installed; continuing."
fi

# --- 4. lnav: log file viewer ---
if ! command -v lnav >/dev/null 2>&1; then
  if [ "$ARCH" = "x86_64" ]; then
    echo "==> Installing lnav..."
    curl -fsSL -o "$WORKDIR/lnav.zip" \
      https://github.com/tstack/lnav/releases/download/v0.14.1/lnav-0.14.1-linux-musl-x86_64.zip
    unzip -q "$WORKDIR/lnav.zip" -d "$WORKDIR/lnav"
    sudo install -m 0755 "$WORKDIR/lnav/lnav-0.14.1/lnav" /usr/local/bin/lnav
  else
    echo "NOTE: Skipping lnav: this pinned binary is x86_64 only."
  fi
fi

# --- 5. bat: syntax-highlighted cat ---
if ! command -v bat >/dev/null 2>&1; then
  echo "==> Installing bat (optional DNF COPR)..."
  sudo dnf copr enable -y fcsm/bat || true
  sudo dnf install -y bat || echo "NOTE: bat was unavailable from DNF; continuing."
fi

# --- 6. Modern CLI tools: ripgrep and fd ---
case "$ARCH" in
  x86_64)  TRIPLE="x86_64-unknown-linux-musl" ;;
  aarch64) TRIPLE="aarch64-unknown-linux-musl" ;;
esac

if ! command -v rg >/dev/null 2>&1; then
  echo "==> Installing ripgrep..."
  curl -fsSL -o "$WORKDIR/rg.tar.gz" \
    "https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/ripgrep-14.1.1-${TRIPLE}.tar.gz"
  tar -xzf "$WORKDIR/rg.tar.gz" -C "$WORKDIR"
  sudo install -m 0755 "$WORKDIR"/ripgrep-14.1.1-*/rg /usr/local/bin/rg
fi

if ! command -v fd >/dev/null 2>&1; then
  echo "==> Installing fd..."
  curl -fsSL -o "$WORKDIR/fd.tar.gz" \
    "https://github.com/sharkdp/fd/releases/download/v10.2.0/fd-v10.2.0-${TRIPLE}.tar.gz"
  tar -xzf "$WORKDIR/fd.tar.gz" -C "$WORKDIR"
  sudo install -m 0755 "$WORKDIR"/fd-v10.2.0-*/fd /usr/local/bin/fd
fi

# --- 7. eza: modern ls with icons, colours and tree view ---
if ! command -v eza >/dev/null 2>&1; then
  case "$ARCH" in
    x86_64)  EZA_ARCH="x86_64-unknown-linux-gnu" ;;
    aarch64) EZA_ARCH="aarch64-unknown-linux-gnu" ;;
  esac
  echo "==> Installing eza..."
  curl -fsSL -o "$WORKDIR/eza.tar.gz" \
    "https://github.com/eza-community/eza/releases/latest/download/eza_${EZA_ARCH}.tar.gz"
  tar -xzf "$WORKDIR/eza.tar.gz" -C "$WORKDIR"
  EZA_BIN="$(find "$WORKDIR" -type f -name eza -perm -u+x -print -quit)"
  if [ -z "$EZA_BIN" ]; then
    echo "ERROR: eza binary was not found in the release archive."
    exit 1
  fi
  sudo install -m 0755 "$EZA_BIN" /usr/local/bin/eza
fi

# --- 8. Useful aliases: eza replaces ls only after successful install ---
if ! grep -q "Linux-Color: eza aliases" "$HOME/.bashrc" 2>/dev/null; then
cat >> "$HOME/.bashrc" <<'EOF'

# Linux-Color: eza aliases
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=auto --color=always'
  alias ll='eza -lah --icons=auto --git --group-directories-first'
  alias la='eza -a --icons=auto --group-directories-first'
  alias lt='eza --tree --level=2 --icons=auto'
fi
alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias h='history'
alias ports='ss -tulpen'
EOF
fi

# --- 9. Coloured prompt ---
if ! grep -q "Linux-Color: custom prompt" "$HOME/.bashrc" 2>/dev/null; then
cat >> "$HOME/.bashrc" <<'EOF'

# Linux-Color: custom prompt
if [[ $- == *i* ]]; then
  PS1='\[\e[1;35m\][\u@\h\[\e[0m\] \[\e[1;33m\]\W\[\e[0m\]]\$ '
fi
EOF
fi

# --- 11. Log analysis toolkit (additive, safe to re-run) ---
echo "==> Installing log analysis tools..."
for pkg in jq htop ncdu sysstat goaccess; do
  sudo dnf install -y "$pkg" || echo "NOTE: $pkg unavailable in DNF; continuing."
done

if ! grep -q "Linux-Color: log toolkit" "$HOME/.bashrc" 2>/dev/null; then
cat >> "$HOME/.bashrc" <<'EOF'

# Linux-Color: log toolkit
alias jerr='sudo journalctl -p err -b --no-pager | tail -50'
alias jf='sudo journalctl -f'
alias jsvc='sudo journalctl -u'
alias errs='sudo grep -rniE "error|fail|fatal|denied|timeout|oom|segfault"'
alias lg='sudo lnav /var/log'
alias biglogs='sudo du -ah /var/log 2>/dev/null | sort -rh | head -15'

# Colour errors red, warnings yellow
hl() {
  sed -u -e 's/.*\(ERROR\|error\|FATAL\|fatal\|Failed\|failed\).*/\x1b[31m&\x1b[0m/' \
         -e 's/.*\(WARN\|warn\).*/\x1b[33m&\x1b[0m/'
}

# Access-log helpers
topip()  { awk '{print $1}' "$1" | sort | uniq -c | sort -rn | head -10; }
top404() { awk '$9==404{print $7}' "$1" | sort | uniq -c | sort -rn | head -10; }

# Coloured man pages
export LESS_TERMCAP_md=$'\e[1;31m'
export LESS_TERMCAP_us=$'\e[1;32m'
export LESS_TERMCAP_so=$'\e[1;44;33m'
export LESS_TERMCAP_me=$'\e[0m' LESS_TERMCAP_ue=$'\e[0m' LESS_TERMCAP_se=$'\e[0m'

# Better history
export HISTSIZE=50000 HISTFILESIZE=100000 HISTTIMEFORMAT='%F %T '
export HISTCONTROL=ignoredups:erasedups
shopt -s histappend
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
EOF
fi

# --- 10. Completion and verification ---
echo
echo "========== Linux-Color installation summary =========="
for tool in eza rg fd bat lnav lolcat; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf '  [OK] %s: %s\n' "$tool" "$(command -v "$tool")"
  else
    printf '  [--] %s: not installed (optional or unavailable)\n' "$tool"
  fi
done
echo "======================================================"
echo
echo "Linux setup complete. Activate with:"
echo "  source ~/.bashrc"

echo
echo "Log analysis guide: Onbarding-FreeTier-AWS/LOG-ANALYSIS.md"
echo
echo "========== WINDOWS / WINDOWS TERMINAL STEPS =========="
echo "1. Download JetBrainsMono Nerd Font:"
echo "   https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip"
echo "2. Extract the ZIP. Install the .ttf files (not README or other files)."
echo "3. Fully close and reopen Windows Terminal."
echo "4. Windows Terminal > Settings > Defaults (or your WSL profile) > Appearance."
echo "5. Set Font face to: JetBrainsMono Nerd Font"
echo "6. Save, open WSL, SSH to this Linux machine, and run: eza --icons=always -lah"
echo "Note: Windows fonts are installed on the client computer, not on this Linux server."
echo "======================================================"
