#!/usr/bin/env bash
# Linux-Color v2 — browser-terminal colours for Amazon Linux 2023
# Target: EC2 Instance Connect in Chrome/Edge (no Nerd Font, no icons)
# Safe to re-run: all colour settings live in ~/.bashrc.d/10-colors.sh
set -Eeuo pipefail

# --- 0. Platform check ---
if ! command -v dnf >/dev/null 2>&1; then
  echo "This script targets Amazon Linux 2023 / DNF-based systems."
  exit 1
fi
ARCH="$(uname -m)"
case "$ARCH" in
  x86_64|aarch64) ;;
  *) echo "Unsupported architecture: $ARCH"; exit 1 ;;
esac

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

echo "==> Installing base packages..."
sudo dnf install -y git make gawk python3-pip unzip tar

# --- 1. ble.sh: syntax highlighting and suggestions while typing ---
if [ ! -f "$HOME/.local/share/blesh/ble.sh" ]; then
  echo "==> Installing ble.sh..."
  git clone --recursive --depth 1 --shallow-submodules \
    https://github.com/akinomyoga/ble.sh.git "$WORKDIR/ble.sh"
  make -C "$WORKDIR/ble.sh" install PREFIX="$HOME/.local"
fi
if ! grep -Fq 'source ~/.local/share/blesh/ble.sh' "$HOME/.bashrc"; then
  echo '[[ $- == *i* ]] && source ~/.local/share/blesh/ble.sh' >> "$HOME/.bashrc"
fi

# --- 2. lnav: coloured log viewer (x86_64 pinned binary) ---
if ! command -v lnav >/dev/null 2>&1; then
  if [ "$ARCH" = "x86_64" ]; then
    echo "==> Installing lnav..."
    curl -fsSL -o "$WORKDIR/lnav.zip" \
      https://github.com/tstack/lnav/releases/download/v0.14.1/lnav-0.14.1-linux-musl-x86_64.zip
    unzip -q "$WORKDIR/lnav.zip" -d "$WORKDIR/lnav"
    sudo install -m 0755 "$WORKDIR/lnav/lnav-0.14.1/lnav" /usr/local/bin/lnav
  else
    echo "NOTE: Skipping lnav: pinned binary is x86_64 only."
  fi
fi

# --- 3. bat: coloured cat ---
if ! command -v bat >/dev/null 2>&1; then
  echo "==> Installing bat..."
  sudo dnf copr enable -y fcsm/bat || true
  sudo dnf install -y bat || echo "NOTE: bat unavailable; continuing."
fi

# --- 4. ripgrep and fd ---
case "$ARCH" in
  x86_64)  TRIPLE="x86_64-unknown-linux-musl" ;;
  aarch64) TRIPLE="aarch64-unknown-linux-musl" ;;
esac
if ! command -v rg >/dev/null 2>&1; then
  echo "==> Installing ripgrep..."
  curl -fsSL -o "$WORKDIR/rg.tar.gz" \
    "https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/ripgrep-14.1.1-${TRIPLE}.tar.gz"
  tar -xzf "$WORKDIR/rg.tar.gz" -C "$WORKDIR"
  sudo install -m 0755 "$WORKDIR"/ripgrep-14.1.1-*/rg /usr/local/bin/rg
fi
if ! command -v fd >/dev/null 2>&1; then
  echo "==> Installing fd..."
  curl -fsSL -o "$WORKDIR/fd.tar.gz" \
    "https://github.com/sharkdp/fd/releases/download/v10.2.0/fd-v10.2.0-${TRIPLE}.tar.gz"
  tar -xzf "$WORKDIR/fd.tar.gz" -C "$WORKDIR"
  sudo install -m 0755 "$WORKDIR"/fd-v10.2.0-*/fd /usr/local/bin/fd
fi

# --- 5. eza: coloured ls ---
if ! command -v eza >/dev/null 2>&1; then
  case "$ARCH" in
    x86_64)  EZA_ARCH="x86_64-unknown-linux-gnu" ;;
    aarch64) EZA_ARCH="aarch64-unknown-linux-gnu" ;;
  esac
  echo "==> Installing eza..."
  curl -fsSL -o "$WORKDIR/eza.tar.gz" \
    "https://github.com/eza-community/eza/releases/latest/download/eza_${EZA_ARCH}.tar.gz"
  tar -xzf "$WORKDIR/eza.tar.gz" -C "$WORKDIR"
  EZA_BIN="$(find "$WORKDIR" -type f -name eza -perm -u+x -print -quit)"
  if [ -z "$EZA_BIN" ]; then
    echo "ERROR: eza binary not found in the release archive."
    exit 1
  fi
  sudo install -m 0755 "$EZA_BIN" /usr/local/bin/eza
fi

# --- 6. 256-colour TERM (loads first, before ble.sh) ---
mkdir -p "$HOME/.bashrc.d"
echo 'export TERM=xterm-256color' > "$HOME/.bashrc.d/00-term.sh"

# --- 7. All colour settings in one managed file (overwritten on each run) ---
cat > "$HOME/.bashrc.d/10-colors.sh" <<'BASHRC_D'
# ===== Linux-Color v2 (managed file; edits are overwritten on re-run) =====

# ls -> eza: colours, folders first, text markers (no icons: browser has no Nerd Font)
alias ls='eza -F --group-directories-first'
alias ll='eza -lahF --git --group-directories-first --color-scale=size'
alias la='eza -aF --group-directories-first'
alias lt='eza --tree --level=2 -F'
# Real ls any time: \ls  or  command ls

# grep / diff / ip / systemd: colour on screen, plain in pipes
export GREP_COLORS='ms=1;33:mc=1;33:fn=35:ln=32:se=36'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -c=auto'
export SYSTEMD_COLORS=true

# Pagers and man pages
export LESS='-R'
export MANPAGER='less -R'
export LESS_TERMCAP_md=$'\e[1;36m'
export LESS_TERMCAP_us=$'\e[1;32m'
export LESS_TERMCAP_so=$'\e[1;43;30m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'

# Prompt: purple user@host, yellow directory
if [[ $- == *i* ]]; then
  PS1='\[\e[1;35m\][\u@\h\[\e[0m\] \[\e[1;33m\]\W\[\e[0m\]]\$ '
fi

# Palette test: run  colors256
colors256() {
  for i in {0..255}; do printf '\e[48;5;%sm  ' "$i"; done
  printf '\e[0m\n'
}
# ===== End Linux-Color v2 =====
BASHRC_D

# --- 8. Load the managed file LAST so older aliases in .bashrc cannot override it ---
if ! grep -Fq 'Linux-Color v2 loader' "$HOME/.bashrc"; then
  {
    echo ''
    echo '# Linux-Color v2 loader (keep as the last line)'
    echo '[ -f ~/.bashrc.d/10-colors.sh ] && source ~/.bashrc.d/10-colors.sh'
  } >> "$HOME/.bashrc"
fi

# --- 9. lnav theme (best effort) ---
if command -v lnav >/dev/null 2>&1; then
  lnav -n -c ':config /ui/theme night-owl' >/dev/null 2>&1 \
    || echo "NOTE: could not set lnav theme; run  :config /ui/theme night-owl  inside lnav."
fi

# --- 10. Summary ---
echo
echo "========== Linux-Color v2 summary =========="
for tool in eza rg fd bat lnav; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf '  [OK] %s: %s\n' "$tool" "$(command -v "$tool")"
  else
    printf '  [--] %s: not installed\n' "$tool"
  fi
done
echo "============================================"
echo "Activate now:  source ~/.bashrc"
echo "Palette test:  colors256"
echo "Log viewer:    sudo lnav /var/log/dnf.log"
